# Neon PostgreSQL 连接串（必填）
# 在 Neon 控制台 Project -> Dashboard -> Connection Details 中复制（选带 -pooler 的那条）
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 可选：登录令牌签名密钥。不配置时自动使用 DATABASE_URL 派生，校内小范围使用足够
# AUTH_SECRET=please-change-me-to-a-random-string

# ===== FileBrowser：后台「直接上传文件」必填（三项都要） =====
# FB_URL：FileBrowser 公网地址，不要带结尾斜杠
FB_URL=https://fb.example.com
# FB_USER / FB_PASS：对该目录有「创建 + 修改」权限的账号
FB_USER=admin
FB_PASS=your-filebrowser-password
# FB_DIR：文件上传到 FileBrowser 的哪个目录，默认 /docs（不存在会自动创建）
FB_DIR=/docs
